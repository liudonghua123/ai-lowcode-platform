# ---------------------------------------------------------------------------
# AI Low-Code Platform / Backend configuration
# Copy to .env:  cp .env.example .env
# ---------------------------------------------------------------------------
APP_NAME=AI Low-Code Platform
APP_ENV=development
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Comma separated origins (frontend dev server, production domain)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite file (relative to backend/). Use an absolute path in production.
DB_PATH=./data/platform.db

# !! CHANGE IN PRODUCTION !! Used to sign JWT access tokens (HS256)
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=7200
MFA_TOKEN_TTL=300

# Initial bootstrap administrator (created only on an empty database)
BOOTSTRAP_ADMIN=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_EMAIL=admin@platform.local

# --- MFA policy (can also be changed at runtime in Auth Settings) ------------
MFA_REQUIRED=false
MFA_METHODS=otp,passkey
MFA_ENFORCED_ROLES=
MFA_ENFORCED_USERS=
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=AI Low-Code Platform
PASSKEY_ORIGIN=http://localhost:5173

# --- AI / AgentScope ---------------------------------------------------------
# mock | openai-compatible | agentscope
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
AGENTSCOPE_ENABLED=true
RAG_TOP_K=4

# --- Other model-service categories (bootstrap defaults) --------------------
# Runtime configurations are managed from the UI (AI Models page) and stored in
# the ai_providers table. These variables are the fallback when no default
# provider exists for a category.
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bm25-local
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=none

# --- MCP ---------------------------------------------------------------------
# The platform exposes its own tools at /mcp (streamable HTTP).
MCP_ENABLED=true
MCP_STATELESS=true
MCP_JSON_RESPONSE=true
# Optional: comma separated third-party MCP server URLs registered at startup
MCP_EXTERNAL_SERVERS=

# --- SSO providers (all optional, configurable from the UI) ------------------
# CAS
CAS_SERVER_URL=https://cas.example.com/cas
CAS_VERSION=3
# OAuth2 / OIDC
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_AUTHORIZE_URL=
OAUTH2_TOKEN_URL=
OAUTH2_USERINFO_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
# WeCom (企业微信)
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# DingTalk (钉钉)
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# Public base URL used to build SSO callback URLs
PUBLIC_BASE_URL=http://localhost:8000
